# ─── Ma'lumotlar bazasi ──────────────────────────────────────────────
# Lokal ishlab chiqish: `npx prisma dev -n takliflar -d` buyrug'i bergan TCP manzil.
# Ishlab chiqarish: O'zbekiston hududidagi serverdagi PostgreSQL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ─── Sessiya ─────────────────────────────────────────────────────────
# Kamida 32 belgi. Yangisini olish:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DIQQAT: ishlab chiqarishda albatta o'zgartiring va hech qachon git'ga qo'ymang.
SESSION_SECRET="bu-yerga-tasodifiy-uzun-maxfiy-kalit"

# Sessiya qancha vaqt amal qiladi (soatda)
SESSION_TTL_HOURS="12"

# ─── Fayl yuklash ────────────────────────────────────────────────────
# Bitta faylning maksimal hajmi (baytda). 10 MB.
MAX_UPLOAD_BYTES="10485760"

# Vercel Blob ombori. Vercel loyihasida Blob store yaratilganda bu
# o'zgaruvchi avtomatik qo'shiladi. Sozlanmagan bo'lsa ilova ishlaydi,
# faqat fayl biriktirish o'rniga tushunarli xabar ko'rsatiladi.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Semantik dublikat qidiruvi (ixtiyoriy) ──
#
# Kalit berilmasa qidiruv eski `pg_trgm` usulida ishlayveradi — tizim
# to'xtamaydi, faqat umumiy so'zi bo'lmagan dublikatlarni topmaydi.
#
# `EMBEDDING_URL` OpenAI ning `/v1/embeddings` shaklini kutadi. Ollama,
# vLLM va llama.cpp ham shu shaklni beradi, ya'ni o'z serveringizga
# ko'chganda faqat shu manzil o'zgaradi.
EMBEDDING_API_KEY=""
# EMBEDDING_URL="https://api.openai.com/v1/embeddings"
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_OLCHAMI="256"
# Chegarani taxmin bilan tanlamang: npm run embedding -- --kalibrlash
# EMBEDDING_CHEGARASI="0.62"
