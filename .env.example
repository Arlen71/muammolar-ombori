# ─── Ma'lumotlar bazasi ──────────────────────────────────────────────
# Lokal ishlab chiqish: `npx prisma dev -n takliflar -d` buyrug'i bergan TCP manzil.
# Ishlab chiqarish: O'zbekiston hududidagi serverdagi PostgreSQL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ─── Sessiya ─────────────────────────────────────────────────────────
# Kamida 32 belgi. Yangisini olish:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DIQQAT: ishlab chiqarishda albatta o'zgartiring va hech qachon git'ga qo'ymang.
SESSION_SECRET="bu-yerga-tasodifiy-uzun-maxfiy-kalit"

# Sessiya qancha vaqt amal qiladi (soatda)
SESSION_TTL_HOURS="12"

# ─── Fayl yuklash ────────────────────────────────────────────────────
# Biriktirmalar saqlanadigan papka (loyiha ildiziga nisbatan yoki absolyut yo'l)
UPLOAD_DIR="./uploads"
# Bitta faylning maksimal hajmi (baytda). 10 MB.
MAX_UPLOAD_BYTES="10485760"

# ─── Ulanishlar hovuzi ───────────────────────────────────────────────
# LOKALDA 1 qo'ying. `prisma dev` PGlite (WASM ichidagi Postgres) ustida ishlaydi
# va parallel ulanishlarni ko'tara olmaydi — ularni uzib yuboradi (P1017 xatosi).
# Bitta ulanishda barcha so'rovlar navbatga tushadi va muammosiz ishlaydi.
#
# ISHLAB CHIQARISHDA 10 qo'ying. Haqiqiy PostgreSQL standart holda 100 ta
# ulanishga ruxsat beradi, bu cheklov u yerda mavjud emas.
DB_POOL_MAX="1"
