{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muammolar-ombori",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: `node:crypto` (scrypt), `node:stream` va Prisma uchun kerak
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Biriktirilgan fayllar. Workers'da fayl tizimi yo'q — hammasi R2 da.
  // Bucket public EMAS: fayllar faqat /api/fayl/[id] orqali, ruxsat
  // tekshirilgandan keyin beriladi.
  // VAQTINCHA O'CHIRILGAN: R2 Cloudflare hisobida hali yoqilmagan.
  // Yoqilgach quyidagini oching va bucketlarni yarating:
  //   npx wrangler r2 bucket create muammolar-ombori-fayllar
  //   npx wrangler r2 bucket create muammolar-ombori-fayllar-preview
  // Binding yo'q bo'lsa ilova qulab tushmaydi — sehrgar fayl yuklash
  // o'rniga tushunarli xabar ko'rsatadi (qarang: omborUlanganmi()).
  // "r2_buckets": [
  //   {
  //     "binding": "BIRIKTIRMALAR",
  //     "bucket_name": "muammolar-ombori-fayllar",
  //     "preview_bucket_name": "muammolar-ombori-fayllar-preview"
  //   }
  // ],

  // Kirishga urinishlar cheklovi. Xotiradagi hisoblagich Workers'da ishlamaydi,
  // chunki har bir isolate alohida. Cloudflare'ning o'z bindingi butun tarmoq
  // bo'ylab hisoblaydi.
  // Diqqat: `period` faqat 10 yoki 60 soniya bo'la oladi.
  "ratelimits": [
    {
      "name": "KIRISH_CHEKLOVI",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": { "enabled": true },

  // Maxfiy qiymatlar bu yerda EMAS. Ular quyidagicha o'rnatiladi:
  //   npx wrangler secret put DATABASE_URL
  //   npx wrangler secret put SESSION_SECRET
  "vars": {
    "SESSION_TTL_HOURS": "12",
    "MAX_UPLOAD_BYTES": "10485760"
  }
}
